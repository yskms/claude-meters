    "error.credential_unavailable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Meters benötigt Zugriff auf die gespeicherte Anmeldung von Claude Code. Bitte bestätige die Systemabfrage, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Meters needs access to Claude Code's saved sign-in. Approve the system prompt to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Meters necesita acceder al inicio de sesión guardado de Claude Code. Aprueba el aviso del sistema para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Meters a besoin d'accéder aux informations de connexion enregistrées de Claude Code. Veuillez autoriser la demande système qui s'affiche pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Meters ha bisogno di accedere alle credenziali salvate di Claude Code. Approva la richiesta di sistema per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude MetersがClaude Codeのログイン情報にアクセスする必要があります。表示されたシステムの許可ダイアログで許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Meters가 Claude Code에 저장된 로그인 정보에 접근해야 합니다. 표시되는 시스템 승인 대화상자에서 허용해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Meters precisa acessar o login salvo do Claude Code. Aprove a solicitação do sistema para continuar."
          }
        }
      }
    },
